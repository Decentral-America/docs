msgstr ":math:`60\\%` من مجموع رسوم المعاملات في المبنى السابق."

#: ../../02_decentralchain/05_node.rst:40
#, python-brace-format
msgid ":math:`\\sum_{i}^{} (f_i - 2 * (\\frac{f_i}{5}))`"
msgstr ":math:`\\sum_{i}^{} (f_i - 2 * (\\frac{f_i}{5}))`"

#: ../../02_decentralchain/05_node.rst:41
