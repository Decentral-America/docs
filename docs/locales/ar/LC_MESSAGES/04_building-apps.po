msgstr ""

#: ../../04_building-apps/12_matcher-api.md
msgid "`https://testnet-matcher.decentralchain.io`"
msgstr ""

#: ../../04_building-apps/12_matcher-api.md
msgid "No public matcher yet"
msgstr ""

#: ../../04_building-apps/12_matcher-api.md:16
msgid "The matcher serves its own OpenAPI reference at [`/api-docs/index.html`](https://testnet-matcher.decentralchain.io/api-docs/index.html). This page covers the endpoints a trading app or bot needs."
msgstr ""

#: ../../04_building-apps/12_matcher-api.md:18
msgid "Matcher Settings"
msgstr ""

