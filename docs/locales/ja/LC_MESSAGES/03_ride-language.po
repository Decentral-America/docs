msgstr "有能なオペレータ: +, -, \\*, /, %, unary minus."

#: ../../03_ride-language/02_data-types.rst:45
msgid "Comparison operators: <, >, <=, and >=."
msgstr "比較演算子: <, >, <=, >=."

