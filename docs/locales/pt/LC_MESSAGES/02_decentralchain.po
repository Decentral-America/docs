msgstr "Para pagamentos anexados ao dApp :ref:`invocação de script <02_decentralchain/03_transaction:Invoke Script Transaction>`."

#: ../../02_decentralchain/02_token(asset).rst:20
msgid "Token Issue"
msgstr "Questão do Token"

#: ../../02_decentralchain/02_token(asset).rst:22
