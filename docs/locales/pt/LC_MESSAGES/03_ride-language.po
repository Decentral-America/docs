msgid "Script"
msgstr "Programa"

#: ../../03_ride-language/10_limitations.md:3
msgid "Account script or asset script (`CONTENT_TYPE EXPRESSION`)"
msgstr "Programa de conta ou script de ativos (`CONTENT_TYPE EXPRESSION`)"

#: ../../03_ride-language/10_limitations.md:3
msgid "8 KB (8,192 bytes)"
msgstr "8 KB (8.192 bytes)"

#: ../../03_ride-language/10_limitations.md:3
msgid "dApp script (`CONTENT_TYPE DAPP`), before feature 17"
msgstr "Programa dApp (`CONTENT_TYPE DAPP`), antes da funcionalidade 17"

#: ../../03_ride-language/10_limitations.md:3
msgid "32 KB (32,768 bytes)"
msgstr "32 KB (32.768 bytes)"

#: ../../03_ride-language/10_limitations.md:3
msgid "dApp script (`CONTENT_TYPE DAPP`), from feature 17"
msgstr "Programa dApp (`CONTENT_TYPE DAPP`), da funcionalidade 17"

#: ../../03_ride-language/10_limitations.md:3
msgid "160 KB (163,840 bytes)"
msgstr "160 KB (163,840 bytes)"

#: ../../03_ride-language/10_limitations.md:3
msgid "Name of a function, variable or callable"
msgstr "Nome de uma função, variável ou callable"

#: ../../03_ride-language/10_limitations.md:3
msgid "255 bytes"
msgstr "255 bytes"

#: ../../03_ride-language/10_limitations.md:37
msgid "The size limit applies to the compiled script, not the source. It depends on the network's features, not on `STDLIB_VERSION`, so a version 5 dApp can be up to 160 KB on the Testnet."
msgstr "O limite de tamanho aplica- se ao programa compilado, não à fonte. Ele depende das características da rede, não do `STDLIB_VERSION`, então uma versão 5 dApp pode ser até 160 KB no Testnet."

#: ../../03_ride-language/10_limitations.md:39
