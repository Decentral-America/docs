msgstr "22"

#: ../../03_ride-language/10_limitations.md:3
msgid "Payments attached to one invocation"
msgstr "Pagamentos associados a uma invocação"

#: ../../03_ride-language/10_limitations.md:3
msgid "`ScriptTransfer`, `Lease`, `LeaseCancel`, `Issue`, `Reissue`, `Burn` and `SponsorFee` actions"
msgstr "`ScriptTransfer`, `Lease`, `LeaseCancel`, `Issue`, `Reissue`, `Burn` e `SponsorFee`"

#: ../../03_ride-language/10_limitations.md:3
msgid "`ScriptTransfer`, `Lease` and `LeaseCancel` actions"
msgstr "Acções `ScriptTransfer`, `Lease` e `LeaseCancel`"

#: ../../03_ride-language/10_limitations.md:3
msgid "`Issue`, `Reissue`, `Burn` and `SponsorFee` actions"
msgstr "Acções `Issue`, `Reissue`, `Burn` e `SponsorFee`"

#: ../../03_ride-language/10_limitations.md:3
msgid "Data entry actions (`BinaryEntry`, `BooleanEntry`, `IntegerEntry`, `StringEntry`, `DeleteEntry`)"
msgstr "Acções de introdução de dados (`BinaryEntry`, `BooleanEntry`, `IntegerEntry`, `StringEntry`, `DeleteEntry`)"

#: ../../03_ride-language/10_limitations.md:3
msgid "Size of a data entry key"
msgstr "Tamanho de uma chave de entrada de dados"

#: ../../03_ride-language/10_limitations.md:3
