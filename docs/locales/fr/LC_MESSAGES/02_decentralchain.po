msgstr "Sera acquis par l'expéditeur si la commande est SELL."

#: ../../02_decentralchain/06_order.rst:62
#, python-brace-format
msgid "Is calculated by the following formula: amount × price × :math:`10^{(priceAssetDecimals - amountAssetDecimals - 8)}`."
msgstr "Est calculé selon la formule suivante : montant × prix × :math:`10^{(priceAssetDecimals - amountAssetDecimals - 8)}`."

#: ../../02_decentralchain/06_order.rst:64
#, python-brace-format
msgid "In orders of versions 1, 2, 3: amount × price × :math:`10^{-8}`"
msgstr "Dans l'ordre des versions 1, 2, 3: montant × prix × :math:`10^{-8}`"

#: ../../02_decentralchain/06_order.rst:65
#, python-brace-format
msgid "In orders of version 4: amount × price × :math:`10^{(priceAssetDecimals - amountAssetDecimals - 8)}`."
msgstr "Dans les ordres de la version 4: montant × prix × :math:`10^{(priceAssetDecimals - amountAssetDecimals - 8)}`."

