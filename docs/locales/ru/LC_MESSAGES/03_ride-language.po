msgstr "Сценарий dApp (`CONTENT_TYPE DAPP`) из функции 17"

#: ../../03_ride-language/10_limitations.md:3
msgid "160 KB (163,840 bytes)"
msgstr "160 КБ (163 840 байт)"

#: ../../03_ride-language/10_limitations.md:3
msgid "Name of a function, variable or callable"
msgstr "Название функции, переменной или вызывающей"

