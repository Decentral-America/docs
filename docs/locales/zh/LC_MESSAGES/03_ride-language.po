#: ../../03_ride-language/07_dapp-to-app-invocation.rst:190
#, python-brace-format
msgid ":math:`W_{AssetPair} = 40 + 30 × 2 + (32 + 40) = 172`"
msgstr ":math:`W_{AssetPair} = 40 + 30 × 2 + (32 + 40) = 172`"

