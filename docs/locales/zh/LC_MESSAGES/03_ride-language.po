#: ../../03_ride-language/01_syntax-basics.rst:136
msgid "Constants"
msgstr "常数"

#: ../../03_ride-language/01_syntax-basics.rst:138
msgid "A constant is a value that cannot be changed by the program during its execution."
msgstr "常数是程序在执行期间无法被更改的值."

