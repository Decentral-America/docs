{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main"
  ],
  "extends": ["config:best-practices", ":semanticCommitTypeAll(chore)"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "schedule": ["* * * * 1"],
  "timezone": "America/Costa_Rica",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "prCreation": "not-pending",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "One weekly PR for all GitHub Actions minor, patch and digest updates",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "One weekly PR for the Sphinx toolchain (docs/requirements.txt) minor and patch updates",
      "groupName": "Python docs toolchain",
      "matchManagers": ["pip_requirements", "pip-compile", "pipenv"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "One weekly PR for the docs/_samples npm package minor and patch updates",
      "groupName": "Docs sample packages",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Pin GitHub Actions to full SHA — Renovate keeps them current",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge GitHub Actions minor/patch/digest updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge pip patch updates",
      "matchManagers": ["pip_requirements", "pip-compile", "pipenv"],
      "matchUpdateTypes": ["patch"]
    },
    {
      "dependencyDashboardApproval": true,
      "description": "Require approval for all major updates",
      "matchUpdateTypes": ["major"]
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "enabled": true,
    "labels": ["security", "dependencies"],
    "prCreation": "immediate"
  }
}
